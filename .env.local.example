# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/selfiam-mailer?retryWrites=true&w=majority

# Resend Email
RESEND_API_KEY=re_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Rate Limiting
DAILY_RATE_LIMIT=25

# Super Admin (comma-separated emails)
SUPER_ADMIN_EMAILS=admin@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=https://mailer.selfiam.site

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your-jwt-secret-here

# SelfIAM Integration (email OTP for auth)
NEXT_PUBLIC_SELFIAM_API_URL=https://selfiam.site
SELFIAM_API_KEY=org_live_REPLACE_WITH_YOUR_KEY
